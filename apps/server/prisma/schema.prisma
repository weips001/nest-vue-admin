// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SysUser {
  id        String    @id @db.VarChar(36)
  userName  String    @unique @map("user_name") @db.VarChar(30)
  avatar    String?   @db.VarChar(100)
  email     String?   @db.VarChar(50)
  nickName  String    @map("nick_name") @db.VarChar(30)
  password  String    @db.VarChar(100)
  phone     String?   @db.VarChar(11)
  sex       String?   @default("0") @db.Char(1)
  status    String?   @default("0") @db.Char(1)
  userType  String?   @map("user_type") @db.VarChar(2)
  deptId    String?   @map("dept_id") @db.VarChar(36)
  postId    String?   @map("post_id") @db.VarChar(36)
  remark    String?   @db.VarChar(255)
  createBy  String?   @map("create_by") @db.VarChar(30)
  createdAt DateTime  @default(now()) @map("created_at")
  updateBy  String?   @map("update_by") @db.VarChar(30)
  updatedAt DateTime  @updatedAt @map("updated_at")
  roles       SysRole[]
  dept        SysDept?  @relation(fields: [deptId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  post        SysPost?  @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  noticeReads SysNoticeRead[]
  todos       SysTodo[]
  /// 密码最后修改时间
  passwordUpdatedAt DateTime  @default(now()) @map("password_updated_at")
  /// 密码历史记录
  passwordHistories SysPasswordHistory[]
  /// 是否需要强制修改密码
  mustChangePassword Boolean @default(false) @map("must_change_password")

  @@index([deptId])
  @@index([phone])
  @@index([status])
  @@map("sys_user")
}

model SysRole {
  id        String       @id @db.VarChar(36)
  name      String       @db.VarChar(30)
  key       String       @unique @db.VarChar(30)
  sort      Int          @default(0)
  status    String       @db.Char(1)
  /// 是否超管角色（超管拥有所有权限，不受数据权限限制）
  isSuper   Boolean      @default(false) @map("is_super")
  /// 数据权限范围 (ALL/CUSTOM/DEPT/DEPT_AND_CHILD/SELF)
  dataScope String       @default("SELF") @map("data_scope") @db.VarChar(20)
  remark    String?      @db.VarChar(255)
  createBy  String?      @map("create_by") @db.VarChar(30)
  createdAt DateTime     @default(now()) @map("created_at")
  updateBy  String?      @map("update_by") @db.VarChar(30)
  updatedAt DateTime     @updatedAt @map("updated_at")
  users     SysUser[]
  menus     SysMenu[]
  menuBtns  SysMenuBtn[]
  depts     SysDept[]
  /// 岗位关联的默认角色
  posts     SysPost[]

  @@map("sys_role")
}

model SysMenu {
  id        Int     @id @default(autoincrement())
  parentId  Int?    @map("parent_id")
  path      String  @db.VarChar(50)
  name      String  @unique @db.VarChar(30)
  auth      String  @db.VarChar(30)
  hidden    Boolean @default(false)
  component String? @db.VarChar(50)
  status    String  @default("0") @db.Char(1)
  sort      Int     @default(0)
  remark    String? @db.VarChar(255)

  createBy   String?            @map("create_by") @db.VarChar(30)
  createdAt  DateTime           @default(now()) @map("created_at")
  updateBy   String?            @map("update_by") @db.VarChar(30)
  updatedAt  DateTime           @updatedAt @map("updated_at")
  // Meta字段直接展开
  meta       SysMenuMeta?
  // 关系定义
  parent     SysMenu?           @relation("MenuTree", fields: [parentId], references: [id])
  children   SysMenu[]          @relation("MenuTree")
  parameters SysMenuParameter[]
  menuBtns   SysMenuBtn[]
  roles      SysRole[]

  @@index([parentId])
  @@map("sys_menu")
}

model SysMenuMeta {
  id          Int      @id @default(autoincrement())
  activeName  String?  @map("active_name")
  keepAlive   Boolean  @default(false) @map("keep_alive")
  defaultMenu Boolean  @default(false) @map("default_menu")
  title       String   @map("title")
  icon        String?  @map("icon")
  closeTab    Boolean  @default(true) @map("close_tab")
  sysMenuId   Int?     @unique @map("sys_menu_id")
  sysMenu     SysMenu? @relation(fields: [sysMenuId], references: [id], onDelete: Cascade)

  @@map("sys_menu_meta")
}

model SysMenuParameter {
  id        Int      @id @default(autoincrement())
  /// query 或者 params
  type      String   @db.VarChar(10)
  key       String?  @db.VarChar(100)
  value     String?  @db.VarChar(191)
  sysMenuId Int?     @map("sys_menu_id")
  sysMenu   SysMenu? @relation(fields: [sysMenuId], references: [id], onDelete: Cascade)

  @@map("sys_menu_parameter")
}

model SysMenuBtn {
  id        Int       @id @default(autoincrement())
  name      String    @db.Char(30)
  auth      String    @db.Char(30)
  sysMenuId Int?      @map("sys_menu_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  sysMenu   SysMenu?  @relation(fields: [sysMenuId], references: [id], onDelete: Cascade)
  roles     SysRole[]

  @@unique([auth, sysMenuId])
  @@map("sys_menu_btn")
}

model SysDict {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(30)
  code      String          @unique @db.VarChar(30)
  sort      Int
  status    String          @db.Char(1)
  remark    String?         @db.VarChar(255)
  createBy  String?         @map("create_by") @db.VarChar(30)
  createdAt DateTime        @default(now()) @map("created_at")
  updateBy  String?         @map("update_by") @db.VarChar(30)
  updatedAt DateTime        @updatedAt @map("updated_at")
  details   SysDictDetail[]

  @@map("sys_dict")
}

model SysDictDetail {
  id          Int      @id @default(autoincrement())
  label       String   @db.VarChar(30)
  value       String   @db.VarChar(30)
  sort        Int
  status      String   @db.Char(1)
  remark      String?  @db.VarChar(255)
  sysDictCode String   @map("sys_dict_code") @db.VarChar(30)
  sysDict     SysDict? @relation(fields: [sysDictCode], references: [code], onDelete: Cascade)
  createBy    String?  @map("create_by") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")
  updateBy    String?  @map("update_by") @db.VarChar(30)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([value, sysDictCode])
  @@map("sys_dict_detail")
}

model SysDept {
  /// id
  id        String    @id @map("id") @db.VarChar(36)
  /// 部门名称
  deptName  String    @unique @map("dept_name") @db.VarChar(30)
  /// 部门编码
  deptCode  String    @unique @map("dept_code") @db.VarChar(20)
  /// 父级部门ID
  parentId  String?   @map("parent_id") @db.VarChar(36)
  /// 祖级部门列表（逗号分隔，如 "1,2,7"）
  ancestors String?   @map("ancestors") @db.VarChar(255)
  /// 联系电话
  phone     String?   @map("phone") @db.VarChar(11)
  /// 邮箱
  email     String?   @map("email") @db.VarChar(50)
  /// 排序
  sort      Int       @default(0) @map("sort")
  /// 启用状态
  status    String    @map("status") @db.VarChar(191)
  /// 备注
  remark    String?   @map("remark") @db.VarChar(255)
  /// 创建人
  createBy  String?   @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 修改人
  updateBy  String?   @map("update_by") @db.VarChar(30)
  /// 修改时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// 父级部门
  parent    SysDept?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 子部门
  children  SysDept[] @relation("DeptTree")
  /// 部门用户
  users     SysUser[]
  /// 部门岗位
  posts     SysPost[]
  /// 数据权限关联的角色
  roles     SysRole[]

  @@index([parentId])
  @@map("sys_dept")
}

model SysPost {
  /// id
  id        String    @id @db.VarChar(36)
  /// 岗位名称
  name      String    @db.VarChar(30)
  /// 岗位编码
  code      String    @unique @db.VarChar(30)
  /// 所属部门ID（null表示公司通用岗位）
  deptId    String?   @map("dept_id") @db.VarChar(36)
  /// 是否负责人岗位
  isLeader  Boolean   @default(false) @map("is_leader")
  /// 排序
  sort      Int       @default(0)
  /// 启用状态
  status    String    @db.Char(1)
  /// 备注
  remark    String?   @db.VarChar(255)
  /// 创建人
  createBy  String?   @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 修改人
  updateBy  String?   @map("update_by") @db.VarChar(30)
  /// 修改时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// 所属部门
  dept      SysDept?  @relation(fields: [deptId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// 岗位用户
  users     SysUser[]
  /// 岗位关联的默认角色
  roles     SysRole[]

  @@map("sys_post")
}

model SysActionLog {
  /// id
  id        Int       @id @default(autoincrement())
  /// 标题
  title     String?   @db.VarChar(50)
  /// 操作类型
  action    String?   @db.VarChar(2)
  /// 请求方式
  method    String?   @db.VarChar(20)
  /// IP
  ip        String?   @db.VarChar(20)
  /// 地址
  address   String?   @db.VarChar(100)
  /// 用户ID
  userId    String?   @map("user_id") @db.VarChar(36)
  /// 姓名
  userName  String?   @map("user_name") @db.VarChar(30)
  /// 请求参数
  params    String?   @db.Text
  /// 响应结果
  result    String?   @db.Text
  /// 错误信息
  errorInfo String?   @map("error_info") @db.Text
  /// 状态
  status    String?   @db.VarChar(1)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("sys_action_log")
}

model SysLoginLog {
  /// id
  id        Int      @id @default(autoincrement())
  /// 用户名
  userName  String   @map("user_name") @db.VarChar(30)
  /// 用户ID（登录成功时有值）
  userId    String?  @map("user_id") @db.VarChar(36)
  /// 登录IP
  ip        String?  @db.VarChar(50)
  /// 登录地点
  location  String?  @db.VarChar(100)
  /// 浏览器
  browser   String?  @db.VarChar(50)
  /// 操作系统
  os        String?  @db.VarChar(50)
  /// 登录状态 (0成功 1失败)
  status    String   @db.Char(1)
  /// 失败原因
  message   String?  @db.VarChar(255)
  /// 登录时间
  createdAt  DateTime  @default(now()) @map("created_at")
  /// 登出时间
  logoutTime DateTime? @map("logout_at")
  /// 令牌过期时间
  expireTime DateTime? @map("expire_at")

  @@index([userName, createdAt])
  @@index([userId, status, logoutTime])
  @@map("sys_login_log")
}

model FileUpload {
  /// id
  id        String    @id @map("id") @db.VarChar(36)
  /// 文件名
  name      String    @map("name") @db.VarChar(100)
  /// 文件地址
  url       String    @map("url") @db.VarChar(191)
  /// 文件标签
  tag       String    @map("tag") @db.VarChar(20)
  /// 编号
  key       String    @map("key") @db.VarChar(191)
  /// 文件大小
  size      Int       @map("size") @db.Int
  /// MIME类型
  mime      String    @map("mime") @db.VarChar(100)
  /// 创建人
  createBy  String?   @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 修改人
  updateBy  String?   @map("update_by") @db.VarChar(30)
  /// 修改时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("file_upload")
}

model SysNotice {
  /// id
  id        String           @id @db.VarChar(36)
  /// 标题
  title     String           @db.VarChar(100)
  /// 内容
  content   String           @db.Text
  /// 类型 (notice公告 warning警告)
  type      String           @default("notice") @db.VarChar(10)
  /// 状态 (0正常 1关闭)
  status    String           @default("0") @db.Char(1)
  /// 创建人
  createBy  String?          @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt DateTime         @default(now()) @map("created_at")
  /// 修改人
  updateBy  String?          @map("update_by") @db.VarChar(30)
  /// 修改时间
  updatedAt DateTime         @updatedAt @map("updated_at")
  /// 阅读记录
  reads     SysNoticeRead[]

  @@map("sys_notice")
}

model SysNoticeRead {
  /// id
  id        String    @id @db.VarChar(36)
  /// 通知ID
  noticeId  String    @map("notice_id") @db.VarChar(36)
  /// 用户ID
  userId    String    @map("user_id") @db.VarChar(36)
  /// 阅读时间
  readAt    DateTime  @default(now()) @map("read_at")

  notice    SysNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user      SysUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@map("sys_notice_read")
}

/// 待办事项
model SysTodo {
  /// id
  id          String    @id @db.VarChar(36)
  /// 标题
  title       String    @db.VarChar(200)
  /// 内容
  content     String    @db.Text
  /// 业务类型：approval审批, confirm确认, review审核
  bizType     String    @db.VarChar(20)
  /// 优先级：urgent紧急, high高, normal普通, low低
  priority    String    @default("normal") @db.VarChar(10)
  /// 状态：pending待处理, completed已完成, cancelled已取消
  status      String    @default("pending") @db.VarChar(20)
  /// 关联链接（跳转处理页面）
  link        String?   @db.VarChar(255)
  /// 关联业务ID（审批单ID等）
  bizId       String?   @map("biz_id") @db.VarChar(36)
  /// 目标用户ID
  userId      String    @map("user_id") @db.VarChar(36)
  /// 创建人
  createBy    String?   @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 完成人
  completeBy  String?   @map("complete_by") @db.VarChar(36)
  /// 完成时间
  completedAt DateTime? @map("completed_at")

  user        SysUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("sys_todo")
}

/// 密码历史记录
model SysPasswordHistory {
  /// 记录ID
  id           String   @id @default(uuid()) @db.VarChar(36)
  /// 用户ID
  userId       String   @map("user_id") @db.VarChar(36)
  /// 密码哈希
  passwordHash String   @map("password_hash") @db.VarChar(100)
  /// 创建时间
  createdAt    DateTime @default(now()) @map("created_at")
  /// 关联用户
  user         SysUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sys_password_history")
}

/// 定时任务
model SysJob {
  /// id
  id        String    @id @db.VarChar(36)
  /// 任务名称
  jobName   String    @map("job_name") @db.VarChar(64)
  /// 任务组名
  jobGroup  String    @map("job_group") @db.VarChar(64)
  /// 调用目标 (格式: service.method(args))
  invokeTarget String @map("invoke_target") @db.VarChar(255)
  /// cron表达式
  cronExpression String @map("cron_expression") @db.VarChar(50)
  /// 执行策略 (1立即执行 2执行一次 3放弃执行)
  misfirePolicy String @default("1") @map("misfire_policy") @db.Char(1)
  /// 是否并发执行 (0允许 1禁止)
  concurrent String @default("1") @db.Char(1)
  /// 状态 (0正常 1暂停)
  status    String    @default("0") @db.Char(1)
  /// 备注
  remark    String?   @db.VarChar(255)
  /// 创建人
  createBy  String?   @map("create_by") @db.VarChar(30)
  /// 创建时间
  createdAt DateTime  @default(now()) @map("created_at")
  /// 修改人
  updateBy  String?   @map("update_by") @db.VarChar(30)
  /// 修改时间
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("sys_job")
}

/// 定时任务执行日志
model SysJobLog {
  /// id
  id            Int       @id @default(autoincrement())
  /// 任务名称
  jobName       String    @map("job_name") @db.VarChar(64)
  /// 任务组名
  jobGroup      String    @map("job_group") @db.VarChar(64)
  /// 调用目标
  invokeTarget  String    @map("invoke_target") @db.VarChar(255)
  /// 日志状态 (0成功 1失败)
  status        String    @default("0") @db.Char(1)
  /// 执行结果信息
  jobMessage    String?   @map("job_message") @db.VarChar(255)
  /// 异常信息
  exceptionInfo String?   @map("exception_info") @db.Text
  /// 开始时间
  startTime     DateTime? @map("start_time")
  /// 结束时间
  endTime       DateTime? @map("end_time")
  /// 创建时间
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([jobName, createdAt])
  @@map("sys_job_log")
}
