{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@app/config(|/.*)$": "<rootDir>/../libs/config/src/$1",
    "^@app/utils(|/.*)$": "<rootDir>/../libs/utils/src/$1"
  }
}
