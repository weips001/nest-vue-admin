# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.
NODE_ENV="development"

DATABASE_URL="mysql://root:password@127.0.0.1:3306/nva?connection_limit=20&pool_timeout=0"



# --- 基础配置 ---
# 端口
APP_PORT=3333
IS_DEMO=false

# --- JWT 认证 ---
# 生产环境请务必更换为强随机密钥（至少16位）
JWT_SECRET=your-secret-key-change-me
# 访问令牌有效期（秒: 2小时 = 7200）
JWT_ACCESS_EXPIRES_IN=7200
# 刷新令牌有效期（秒: 7天 = 604800）
JWT_REFRESH_EXPIRES_IN=604800

# --- 缓存配置 (memory / redis) ---
CACHE_MODE=memory
CACHE_TTL=60000

# --- Redis 配置 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=6
REDIS_USERNAME=
REDIS_PASSWORD=

# --- 验证码配置 ---
CAPTCHA_SIZE=4
CAPTCHA_WIDTH=100
CAPTCHA_HEIGHT=40

# --- 文件上传配置 ---
# 模式: local 或 aliyun
UPLOAD_MODE=local
# 最大文件大小 (字节: 20MB = 20971520)
UPLOAD_MAX_FILE_SIZE=20971520

# [本地上传]
UPLOAD_LOCAL_FOLDER=uploads
UPLOAD_LOCAL_PREFIX=/uploads
# 生产环境请修改为域名
UPLOAD_LOCAL_BASE_URL=http://127.0.0.1:3333

# [阿里云 OSS]
ALIYUN_REGION=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_BUCKET=
ALIYUN_FOLDER=
ALIYUN_BASE_URL=

# --- 接口限流配置 ---
# 时间窗口 (秒)
THROTTLE_TTL=60
# 时间窗口内最大请求数
THROTTLE_LIMIT=60

# --- 账号安全配置 ---
# 连续登录失败最大次数
LOGIN_MAX_FAIL_COUNT=5
# 锁定时长 (分钟)
LOGIN_LOCK_MINUTES=30

# --- 密码策略配置 ---
# 密码历史保留条数（防止重复使用最近N次密码，0表示不检查）
PASSWORD_HISTORY_COUNT=5
# 密码过期天数（0表示永不过期）
PASSWORD_EXPIRE_DAYS=90
